# ── LLM Provider ─────────────────────────────────────────
# Options: groq | ollama | openai
LLM_PROVIDER=groq

# Groq (default, requires internet)
GROQ_API_KEY=api
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (air-gapped, 100% offline)
# Setup: brew install ollama && ollama pull llama3:70b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b

# OpenAI (optional)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o

# ── Execution Backend ────────────────────────────────────
# Options: subprocess | docker | modal | runpod
EXECUTION_BACKEND=subprocess

# Docker sandbox settings
OMNIML_DOCKER_IMAGE=omniml-sandbox:latest
DOCKER_CPU_LIMIT=2.0
DOCKER_MEMORY_LIMIT=4g
DOCKER_TIMEOUT_SECONDS=600
DOCKER_NETWORK_MODE=none

# Modal serverless GPU
MODAL_TOKEN_ID=your_modal_token_id
MODAL_TOKEN_SECRET=your_modal_token_secret
MODAL_GPU_TYPE=T4

# RunPod serverless GPU
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_endpoint_id

# ── Kaggle ───────────────────────────────────────────────
KAGGLE_USERNAME=api
KAGGLE_KEY=api

# ── Chainlit ─────────────────────────────────────────────
CHAINLIT_AUTH_SECRET=your_random_secret

# ── Training ─────────────────────────────────────────────
TRAINING_TIMEOUT=600
